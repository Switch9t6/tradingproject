# Upstox Developer App API Credentials
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
OAUTH_PORT=5000

# Automated Headless TOTP Authentication Credentials (Optional for cloud deployment)
UPSTOX_USER_ID=your_upstox_user_id
UPSTOX_PIN=your_6_digit_pin
UPSTOX_TOTP_SECRET=your_totp_secret_key

# News Aggregator API Keys
FINNHUB_API_KEY=your_finnhub_api_key_here

# Telegram Instant Trade Alerts (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
