# Upstox API v2 Credentials
UPSTOX_API_KEY="your_upstox_api_key"
UPSTOX_API_SECRET="your_upstox_api_secret"
UPSTOX_REDIRECT_URI="https://localhost"
UPSTOX_ACCESS_TOKEN="your_upstox_access_token"

# Upstox Automated TOTP Headless Login Credentials
UPSTOX_USERNAME="your_upstox_username_or_mobile"
UPSTOX_PIN_CODE="your_upstox_6digit_pin"
UPSTOX_TOTP_SECRET="your_upstox_totp_secret_key"

# Telegram Bot Notifications & Remote Controls
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# System Configuration
ENVIRONMENT="production"
